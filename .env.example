# Application
APP_NAME=observability-commerce-platform
APP_ENV=dev
APP_VERSION=1.0.0
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
BACKEND_PORT=8080
SERVER_CONTEXT_PATH=
# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=observability_db
DB_USERNAME=observability_user
DB_PASSWORD=change_me
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# External-service simulation
PAYMENT_SERVICE_URL=http://localhost:8080/mock/payment
SHIPPING_SERVICE_URL=http://localhost:8080/mock/shipping
PAYMENT_DELAY_MS=150
PAYMENT_FAILURE_RATE=0
SHIPPING_DELAY_MS=200
SHIPPING_FAILURE_RATE=0
# Diagnostics and jobs
ENABLE_DIAGNOSTIC_ENDPOINTS=true
ENABLE_SLOW_DB_TESTS=false
DIAGNOSTIC_DELAY_MS=3000
INVENTORY_JOB_INTERVAL_MS=60000
ORDER_PROCESSOR_INTERVAL_MS=30000
SHIPMENT_PROCESSOR_INTERVAL_MS=45000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRAFFIC_REQUESTS=30
TRAFFIC_CONCURRENCY=3
TRAFFIC_DELAY_MS=100
